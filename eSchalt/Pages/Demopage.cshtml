@page
@model eSchalt.Pages.DemopageModel
@{
    ViewData["Title"] = "Electrical Cabinet Viewer";
}

<div class="flex">
    <!-- Top Side: Image Map -->
    <div class="w-2/3 relative">
        <img src="/images/electrical_cabinets/demopage.jpg" alt="Electrical Cabinet" usemap="#cabinet-map" class="w-full">
        <map name="cabinet-map">
            <!-- Define clickable areas here -->
            <area shape="rect" coords="50,50,150,150" href="javascript:void(0)" onclick="document.getElementById('componentId').value='1'; document.getElementById('form').submit();">
            <area shape="rect" coords="200,50,300,150" href="javascript:void(0)" onclick="document.getElementById('componentId').value='2'; document.getElementById('form').submit();">
            <area shape="rect" coords="350,50,450,150" href="javascript:void(0)" onclick="document.getElementById('componentId').value='3'; document.getElementById('form').submit();">
            <area shape="rect" coords="50,200,150,300" href="javascript:void(0)" onclick="document.getElementById('componentId').value='4'; document.getElementById('form').submit();">
            <area shape="rect" coords="200,200,300,300" href="javascript:void(0)" onclick="document.getElementById('componentId').value='5'; document.getElementById('form').submit();">
            <area shape="rect" coords="350,200,450,300" href="javascript:void(0)" onclick="document.getElementById('componentId').value='6'; document.getElementById('form').submit();">
            <area shape="rect" coords="50,350,150,450" href="javascript:void(0)" onclick="document.getElementById('componentId').value='7'; document.getElementById('form').submit();">
            <area shape="rect" coords="200,350,300,450" href="javascript:void(0)" onclick="document.getElementById('componentId').value='8'; document.getElementById('form').submit();">
            <area shape="rect" coords="350,350,450,450" href="javascript:void(0)" onclick="document.getElementById('componentId').value='9'; document.getElementById('form').submit();">
        </map>
    </div>

    <!-- Bottom Side: Component Info -->
    <div class="w-1/3 border-l pl-4">
        <h2 class="text-xl font-bold">Component Information</h2>
        <div id="component-info">
            <!-- Display the result of the query -->
            @if (!string.IsNullOrEmpty(Model.ComponentInfo))
            {
                <p>@Html.Raw(Model.ComponentInfo)</p>
            }
            else
            {
                <p>Select a component to view details.</p>
            }
        </div>
    </div>
</div>



<!-- Hidden form for submitting component ID -->
<form id="form" method="post">
    <input type="hidden" id="componentId" name="componentId" />
</form>
