@page
@model eSchalt.Pages.DemopageModel
@{
    ViewData["Title"] = "Electrical Cabinet Viewer";
}

<div class="flex">
    <!-- Left Side: Image Map -->
    <div class="w-2/3 relative">
        <img src="/path/to/20241021_072756.jpg" alt="Electrical Cabinet" usemap="#cabinet-map" class="w-full">
        <map name="cabinet-map">
            <!-- Define clickable areas here -->
            <!-- Example: -->
            <area shape="rect" coords="50,50,150,150" href="javascript:void(0)" onclick="loadComponentInfo(1)">
            <area shape="rect" coords="200,50,300,150" href="javascript:void(0)" onclick="loadComponentInfo(2)">
            <!-- Add more areas with respective coordinates -->
        </map>
    </div>

    <!-- Right Side: Component Info -->
    <div class="w-1/3 border-l pl-4">
        <h2 class="text-xl font-bold">Component Information</h2>
        <div id="component-info">
            <p>Select a component to view details.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function loadComponentInfo(componentId) {
            const response = await fetch(`/DemoPage?handler=GetComponentInfo&componentId=${componentId}`);
            const data = await response.json();
            
            const infoDiv = document.getElementById('component-info');
            if (data) {
                infoDiv.innerHTML = `
                    <p><strong>Name:</strong> ${data.name}</p>
                    <p><strong>Description:</strong> ${data.description}</p>
                    <p><strong>Location:</strong> ${data.location}</p>
                `;
            } else {
                infoDiv.innerHTML = `<p>Component information not found.</p>`;
            }
        }
    </script>
}