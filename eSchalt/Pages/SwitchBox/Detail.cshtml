@page "/detail"
@model eSchalt.Pages.SwitchBox.DetailpageModel
@{
    ViewData["Title"] = "Schaltkasten Informationen";
}
<div class="container">
    <h1 class="border-bottom mb-g mt-gd pb-3">@ViewData["Title"]</h1>

    <div class="row g-3 g-lg-5">
        <div class="col-lg-6">
            <img class="w-100 rounded-5 shadow" src="/images/electrical_cabinets/demopage.jpg" alt="Electrical Cabinet" usemap="#cabinet-map">
        </div>

        <div class="col-lg-6">
            @if (Model.Component != null)
            {
                <div class="bg-primary text-white rounded-5 p-4">
                    <h2 class="text-xl font-bold">Allgemeine Informationen</h2>
                    <div class="d-flex">
                        <div>
                            <span class="fw-bold">Raum:</span> @Model.Component.Raum<br/>
                            <span class="fw-bold">Stockwerk:</span> @Model.Component.Stockwerk<br/>
                        </div>
                        <div class="ms-5">
                            <span class="fw-bold">Typ PD:</span> @Model.Component.Typ<br/>
                            <span class="fw-bold">Gruppe:</span> @Model.Component.Gruppe<br/>
                        </div>
                    </div>
                </div>
                <div class="p-4">
                    <h2 class="text-xl font-bold">Ausgewählte Komponente:</h2>
                    <div class="fw-bold">Name: S1</div>
                    <div class="fw-bold">Verbunden mit:</div>
                    <div>...</div>
                </div>
            }
            else
            {
            <div id="component-info" class="fst-italic">Es konnten leider keine Informationen gefunden werden.</div>
            }
        </div>
    </div>
</div>


<form id="form" method="get">
    <input type="hidden" id="componentId" name="componentId" />
</form>