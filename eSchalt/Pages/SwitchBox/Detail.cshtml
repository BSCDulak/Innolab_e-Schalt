@page "/detail"
@using eSchalt.Frontend.Classes.Models
@model eSchalt.Pages.SwitchBox.DetailpageModel
@{
    ViewData["Title"] = "Schaltkasten Informationen";
    ViewData["Description"] = "Hier werden alle Informationen zu einem Schaltkasten angezeigt.";
}
<div class="container">
    <h1>@ViewData["Title"]</h1>

    @* Photo / Camera Links *@
    <div class="pb-4">
        @await Html.PartialAsync("_PhotoList")
    </div>

    @* Image with clickable componentes *@
    <div class="row g-3 g-lg-5">
        <div class="col-lg-6">
            <div class="position-relative">
                <img class="w-100 rounded-5 shadow" src="@Model.ImagePath" alt="Electrical Cabinet">

                @* Clickable components *@
                <form method="post">
                    <input type="hidden" name="fileName" value="@Model.FileName" />
                    @foreach (Component component in Model.SwitchBox?.Components ?? Enumerable.Empty<Component>())
                    {
                        bool isSelected = Model.SelectedComponent?.Id == component.Id;
                        <button
                            type="submit"
                            name="selectedComponent"
                            value="@component.Id"
                            title="@component.Name"
                            class="component component-onclick @(Model.SelectedComponent?.Id == component.Id ? "selected" : "")"
                            style="top: @component.ButtonTop%; left: @component.ButtonLeft%; width: @component.ButtonWidth%; height: @component.ButtonHeight%;"
                            disabled="@isSelected"></button>
                        
                        @* Connections *@
                        @if (isSelected)
                        {
                            <svg class="position-absolute top-0 w-100 h-100" style="pointer-events: none;">
                                @foreach (var connection in component.Connections)
                                {
                                    Component topComponent = (component.ButtonTop <= connection.ButtonTop) ? component : connection;
                                    Component bottomComponent = (component.ButtonTop > connection.ButtonTop) ? component : connection;
                                    // Start the line at the bottom center of the top component
                                    double x1 = topComponent.ButtonLeft + topComponent.ButtonWidth / 2;
                                    double y1 = topComponent.ButtonTop + topComponent.ButtonHeight;
                                    // End the line at the top center of the bottom component
                                    double x2 = bottomComponent.ButtonLeft + bottomComponent.ButtonWidth / 2;
                                    double y2 = bottomComponent.ButtonTop;
                                    
                                    <line
                                        x1="@x1%" y1="@y1%"
                                        x2="@x2%" y2="@y2%"
                                        stroke="var(--bs-primary)" stroke-width="7" />
                                    <line
                                        x1="@x1%" y1="@y1%"
                                        x2="@x2%" y2="@y2%"
                                        stroke="white"
                                        stroke-width="3" />
                                }
                            </svg>
                        }
                    }
                </form>
            </div>
        </div>

        @* Selected Component Info *@
        <div class="col-lg-6">
            <div class="bg-primary text-white rounded-5 p-4">
                <h2 class="text-xl font-bold">Allgemeine Informationen</h2>
                <div class="d-flex">
                    @if (Model.SwitchBox != null)
                    {
                        <div>
                            <span class="fw-bold">Raum:</span> @Model.SwitchBox.Room<br/>
                            <span class="fw-bold">Stockwerk:</span> @Model.SwitchBox.Floor<br/>
                        </div>
                        <div class="ms-5">
                            <span class="fw-bold">Typ PD:</span> @Model.SwitchBox.Type<br/>
                            <span class="fw-bold">Gruppe:</span> @Model.SwitchBox.Group<br/>
                        </div>
                    }
                    else
                    {
                        <div>Es konnten leider keine Informationen gefunden werden.</div>
                    }
                </div>
                
                @* QR Code Display *@
                @if (!string.IsNullOrEmpty(Model.QrCodeImageBase64))
                {
                    <div class="mt-3">
                        <span class="fw-bold">QR-Code zum Teilen:</span>
                        <div class="mt-2">
                            <img src="data:image/png;base64,@Model.QrCodeImageBase64" 
                                 alt="QR Code" 
                                 class="bg-white p-2 rounded"
                                 style="max-width: 200px; height: auto;" />
                        </div>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(Model.FileName) && Model.IsImageInTempFolder)
                {
                    <form method="post" asp-page-handler="SaveSwitchBox" class="mt-3">
                        <input type="hidden" name="fileName" value="@Model.FileName" />
                        <button type="submit" class="btn btn-light">Schaltkasten speichern</button>
                    </form>
                }
            </div>
            <div class="p-4">
                @if (Model.SelectedComponent != null)
                {
                    <h2 class="text-xl font-bold">Ausgewählte Komponente:</h2>
                    <div><span class="fw-bold">Name:</span> @Model.SelectedComponent.Name</div>
                    <div class="fw-bold">Verbunden mit:</div>
                    @if (Model.SelectedComponent.Connections.Count > 0)
                    {
                        <form method="post">
                            <input type="hidden" name="fileName" value="@Model.FileName" />
                            @foreach (Component connection in Model.SelectedComponent.Connections)
                            {
                                <button
                                    type="submit"
                                    name="selectedComponent"
                                    value="@connection.Id"
                                    title="@connection.Name"
                                    class="btn btn-secondary"
                                >@connection.Name</button>
                            }
                        </form>
                    }
                    else
                    {
                        <div class="fst-italic">Keine Verbindungen gefunden</div>
                    }
                    
                }
                else
                {
                    <div id="component-info" class="fst-italic">Es wurde noch keine Komponente ausgewählt.</div>
                }
            </div>
        </div>
    </div>
</div>
