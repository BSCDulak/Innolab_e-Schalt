@page "/qrcode"
@model eSchalt.Pages.Photo.QRCode

@{
    ViewData["Title"] = "QR-Code scannen";
    ViewData["Description"] = "Scanne den QR-Code von deinem Schaltkasten";
}

@* Hier wird der QR-Code gescannt. Die Details page handelt dann welche SwitchBox das ist*@
<div class="container">
    <h1>@ViewData["Title"]</h1>

    <h3>Scan QR Code</h3>
    <div id="reader" style="width: 300px; margin: auto;"></div>
    <p id="result">Waiting for scan...</p>

</div>

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<script>
    function onScanSuccess(decodedText, decodedResult) {
        document.getElementById("result").innerText = `Scanned: ${decodedText}`;

        // Determine if it's relative or absolute
        let targetUrl;
        if (decodedText.startsWith("http")) {
            // Absolute URL -> just redirect
            targetUrl = decodedText;
        } else if (decodedText.startsWith("/")) {
            // Relative URL -> prepend current host, this means we are not bound to just localhost for future changes
            targetUrl = window.location.origin + decodedText;
        } else {
            // If it’s just a filename, assume it's the file in /detail, this is just convenient fluff
            targetUrl = `/detail?fileName=${encodeURIComponent(decodedText)}`;
            targetUrl = window.location.origin + targetUrl;
        }

        // Redirect to the target URL
        window.location.href = targetUrl;
    }

    function onScanFailure(error) {
        // Optional: log scan failures
        // console.warn(`Scan failed: ${error}`);
    }

    const html5QrCode = new Html5Qrcode("reader");

    html5QrCode.start(
        { facingMode: "environment" }, // use back camera
        {
            fps: 10,
            qrbox: 250
        },
        onScanSuccess,
        onScanFailure
    ).catch(err => {
        console.error("Camera start error:", err);
    });
</script>
</div>