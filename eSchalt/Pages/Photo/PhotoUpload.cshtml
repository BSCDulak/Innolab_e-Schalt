@page "/foto/hochladen"
@model eSchalt.Pages.Photo.PhotoUploadModel
@{
    ViewData["Title"] = "Foto hochladen";
    ViewData["Description"] = "Lade ein Foto von einem Schaltkasten hoch.";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>

    <div class="mb-4">@await Html.PartialAsync("_ReturnToHomepage")</div>
    <form method="post" enctype="multipart/form-data">
        <div class="text-center">
            <div class="bg-body-secondary rounded-5 p-4 p-md-5">
                <div class="border-container--file-upload rounded-5 p-5">
                    <div class="icons fa-4x">
                        <i class="fa-solid fa-image" aria-hidden="true"></i>
                        <span class="sr-only">Bild</span>
                    </div>
                    <input type="file" accept=".jpg,.jpeg,.png" id="photoUpload" name="photo" class="rounded-5" required/>
                    <p id="infoText" class="text-break">Ziehe Dateien hierher oder wähle sie von deinem Computer aus.</p>
                </div>
            </div>
            <div class="mt-4 d-flex gap-3 justify-content-center flex-wrap">
                <button id="uploadButton" name="action" value="update" class="btn btn-primary px-5 py-3" type="submit">Hochladen (Überschreiben)</button>
                <button id="uploadButtonNew" name="action" value="new" class="btn btn-secondary px-5 py-3" type="submit">Hochladen (neuer Schaltschrank)</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Disable / Enable Upload Button
        const photoInput = document.getElementById('photoUpload')
        const uploadButton = document.getElementById('uploadButton')

        const uploadButtonNew = document.getElementById('uploadButtonNew')
        uploadButton.disabled = true;
        uploadButtonNew.disabled = true;
        photoInput.addEventListener('change', () => {
            const hasFile = photoInput.files.length > 0;
            uploadButton.disabled = !hasFile;
            uploadButtonNew.disabled = !hasFile;
        });

        // Change info text to uploaded image
        const infoText = document.getElementById('infoText')
        const container = document.getElementsByClassName('border-container--file-upload')[0]
        photoInput.addEventListener('change', () => {

            if (photoInput.files.length) {
                infoText.innerHTML = `Bild ausgewählt: <span class="fw-bold">${photoInput.files[0].name}</span>`
                container.classList.add('file-uploaded')
            } else {
                infoText.textContent = 'Ziehe Dateien hierher oder wähle sie von deinem Computer aus.'
                container.classList.remove('file-uploaded')
            }
        });
    </script>
}