@page
@model IndexModel
@{
    ViewData["Title"] = "Startseite";
    ViewData["Description"] = "Lass dir alle Informationen für einen Schaltkasten anzeigen. Einfach einen Schaltkasen scannen und loslegen.";
}

<div class="container text-center">
    <h1 class="display-4">Willkommen!</h1>

    @{
        bool isSwitchBoxSet = !string.IsNullOrEmpty(Request.Cookies["SwitchBoxId"]);
    }
    @* Setup *@
    <div class="rounded-4 p-4 mb-4 border-dotted d-flex d-sm-block flex-column @(isSwitchBoxSet ? "bg-success" : "border-dotted-primary")">
        <div class="text-body-secondary mb-3 fst-italic">Scanne den QR-Code von deinem existierenden Schaltkasten oder erstelle einen neuen.</div>
        
        <a asp-page="/Photo/QRCode" class="btn @(isSwitchBoxSet ? "btn-primary" : "btn-secondary")">
            <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
            @(isSwitchBoxSet ? "Neuen " : "")
            QR-Code scannen
        </a>
        <span>oder</span>
        <a asp-page="/Photo/PhotoUpload" class="btn btn-secondary">
            <i class="fa-solid fa-upload" aria-hidden="true"></i>
            Foto für neuen Schaltkasten hochladen.
        </a>
    </div>  
</div>