@page
@model IndexModel
@{
    ViewData["Title"] = "Startseite";
    ViewData["Description"] = "Lass dir alle Informationen für einen Schaltkasten anzeigen. Einfach einen Schaltkasen scannen und loslegen.";
}

<div class="container text-center">
    <h1 class="display-4">Willkommen!</h1>

    @{
        bool isSwitchBoxSet = !string.IsNullOrEmpty(Request.Cookies["SwitchBoxId"]);
    }
    @* Step 1 *@
    <div class="rounded-4 p-4 mb-4 border-dotted @(isSwitchBoxSet ? "bg-success" : "border-dotted-primary")">
        <h2>Schritt 1</h2>
        <div class="text-body-secondary mb-3 fst-italic">Scanne zuerst den QR-Code von deinem Schaltkasten.</div>
        
        @* TODO page updaten wenn mit branch gemerged wo qr code oben ist *@
        <a asp-page="/Photo/QRCode" class="btn @(isSwitchBoxSet ? "btn-primary" : "btn-secondary")">
            <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
            @(isSwitchBoxSet ? "Neuen " : "")
            QR-Code scannen
        </a>
    </div>  

    @* Step 2 *@
    <div class="rounded-4 p-4 mb-4 border-dotted @(isSwitchBoxSet ? "border-dotted-primary" : "")">
        <h2>Schritt 2</h2>
        <div class="text-body-secondary mb-3 fst-italic">Mache danach ein Foto oder lade ein Foto hoch.
            Für dieses Foto werden dir alle wichtigen Informationen, Komponenten und Verbindungen angezeigt.</div>
        
        <div>
            @if (isSwitchBoxSet)
            {
                <a asp-page="/Photo/Camera" class="btn btn-secondary">
                    <i class="fa-solid fa-camera" aria-hidden="true"></i>
                    Kamera
                </a>
                <span>oder</span>
                <a asp-page="/Photo/PhotoUpload" class="btn btn-secondary">
                    <i class="fa-solid fa-upload" aria-hidden="true"></i>
                    Foto hochladen
                </a>
            }
            else
            {
                <span class="btn btn-disabled">
                    <i class="fa-solid fa-camera" aria-hidden="true"></i>
                    Kamera
                </span>
                <span>oder</span>
                <span class="btn btn-disabled">
                    <i class="fa-solid fa-upload" aria-hidden="true"></i>
                    Foto hochladen
                </span>
            }
            
        </div>
    </div>
</div>